nextflow_pipeline {

    name "Test main.nf exits when given invalid downsampling parameters"
    script "main.nf"

    test("Should fail when downsampling is enabled and downsampling_size is not an integer") {

        def resolvedSheet

        setup {
            resolvedSheet = ManifestResolver.resolveSheet(projectDir, launchDir, "raw-fastq-se.csv")
        }

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                downsampling = true
                downsampling_size = "not_an_integer"
                downsampling_seed = 413
            }
        }

        then {
            assert workflow.failed
        }
        cleanup {
            if (resolvedSheet && resolvedSheet.exists()) {
                if (!resolvedSheet.delete()) {
                    throw new IllegalStateException("Failed to delete resolved samplesheet: ${resolvedSheet}")
                }
            }
        }

    }
}
