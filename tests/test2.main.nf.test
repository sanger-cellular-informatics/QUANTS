nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures with raw_sequencing_qc enabled") {

        def resolvedSheet

        setup {
            resolvedSheet = ManifestResolver.resolveSheet(projectDir, launchDir, "trimmed-fastq-se2.csv")
        }

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                raw_sequencing_qc = true
                read_modification = true
                append_quality = "?"
                quantification = "pyquest"
                pyquest_library_converter_options = "-N 1 -S 24"
            }
        }

        then {
            assert workflow.success
        }
        cleanup {
            if (resolvedSheet && resolvedSheet.exists()) {
                if (!resolvedSheet.delete()) {
                    throw new IllegalStateException("Failed to delete resolved samplesheet: ${resolvedSheet}")
                }
            }
        }

    }

}
