nextflow_pipeline {
    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures with transform_library enabled") {

        def resolvedSheet

        setup {
            resolvedSheet = ManifestResolver.resolveSheet(projectDir, launchDir, "trimmed-fastq-se1.csv")
        }

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                read_modification = true
                append_quality = "?"
                transform_library = true
                pyquest_library_converter_options = "-N 1 -S 24"
                quantification = "pyquest"
            }
        }
        then {
            assert workflow.success
        }
        cleanup {
            if (resolvedSheet && resolvedSheet.exists()) {
                if (!resolvedSheet.delete()) {
                    throw new IllegalStateException("Failed to delete resolved samplesheet: ${resolvedSheet}")
                }
            }
        }
    }
}
