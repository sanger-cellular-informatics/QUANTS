nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run multi-sample single-end QC, adapter trimming, and primer trimming without failures") {

        def resolvedSheet

        setup {
            resolvedSheet = ManifestResolver.resolveSheet(projectDir, launchDir, "raw-fastq-se-multiple-samples10.csv")
        }

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                raw_sequencing_qc = true
                adapter_trimming = "cutadapt"
                adapter_trimming_qc = true
                primer_trimming = "cutadapt"
                primer_trimming_qc = true
            }
        }

        then {
            assert workflow.success
        }
        cleanup {
            if (resolvedSheet && resolvedSheet.exists()) {
                if (!resolvedSheet.delete()) {
                    throw new IllegalStateException("Failed to delete resolved samplesheet: ${resolvedSheet}")
                }
            }
        }

    }

}
